# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA
# Sistema de Biblioteca Digital de Videos Educativos
# Unidad Educativa San Francisco Xavier
# ==============================================================================

# ------------------------------------------------------------------------------
# ENTORNO
# ------------------------------------------------------------------------------

# Entorno de la aplicación (development, production)
APP_ENV=development

# Modo debug (true, false)
# IMPORTANTE: Desactivar en producción
DEBUG=true

# Zona horaria
TIMEZONE=America/La_Paz

# ------------------------------------------------------------------------------
# BASE DE DATOS
# ------------------------------------------------------------------------------

# Host del servidor MySQL
DB_HOST=localhost

# Puerto de MySQL (por defecto 3306)
DB_PORT=3306

# Nombre de la base de datos
DB_NAME=videoteca_educativa

# Usuario de MySQL
DB_USER=root

# Contraseña de MySQL
DB_PASS=

# Charset de la base de datos
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# JWT (JSON WEB TOKENS)
# ------------------------------------------------------------------------------

# Clave secreta para firmar tokens JWT
# IMPORTANTE: Cambiar en producción por una clave única y compleja
# Debe tener al menos 32 caracteres
JWT_SECRET=videoteca_sfxavier_secret_key_2024_change_in_production

# Emisor del token (issuer)
JWT_ISSUER=videoteca.sfxavier.edu.bo

# Audiencia del token (audience)
JWT_AUDIENCE=videoteca.sfxavier.edu.bo

# Tiempo de expiración del access token en segundos
# Por defecto: 3600 (1 hora)
JWT_ACCESS_EXPIRATION=3600

# Tiempo de expiración del refresh token en segundos
# Por defecto: 604800 (7 días)
JWT_REFRESH_EXPIRATION=604800

# ------------------------------------------------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------

# Orígenes permitidos para hacer peticiones (separados por coma)
# En desarrollo: agregar URL del frontend
# En producción: solo dominios específicos
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# UPLOADS
# ------------------------------------------------------------------------------

# Tamaño máximo de archivo de video en bytes
# Por defecto: 524288000 (500MB)
MAX_VIDEO_SIZE=524288000

# Tamaño máximo de archivo de imagen en bytes
# Por defecto: 5242880 (5MB)
MAX_IMAGE_SIZE=5242880

# ------------------------------------------------------------------------------
# RUTAS DE ARCHIVOS
# ------------------------------------------------------------------------------

# Directorio de uploads de videos (relativo al backend)
UPLOAD_VIDEO_DIR=/uploads/videos

# Directorio de thumbnails (relativo al backend)
UPLOAD_THUMBNAIL_DIR=/uploads/thumbnails

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------

# Nivel de logging (debug, info, warning, error, critical)
LOG_LEVEL=info

# Días de retención de logs en base de datos
LOG_RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# SEGURIDAD
# ------------------------------------------------------------------------------

# Número máximo de intentos de login antes de bloquear usuario
MAX_LOGIN_ATTEMPTS=5

# Tiempo de bloqueo en minutos después de superar intentos
LOGIN_BLOCK_DURATION=30

# ------------------------------------------------------------------------------
# NOTIFICACIONES
# ------------------------------------------------------------------------------

# Habilitar sistema de notificaciones (true, false)
NOTIFICATIONS_ENABLED=true

# ------------------------------------------------------------------------------
# FFMPEG (Procesamiento de Videos)
# ------------------------------------------------------------------------------

# Ruta al ejecutable de FFmpeg (dejar vacío si está en PATH)
FFMPEG_PATH=ffmpeg

# Ruta al ejecutable de FFprobe (dejar vacío si está en PATH)
FFPROBE_PATH=ffprobe

# ------------------------------------------------------------------------------
# RENDIMIENTO
# ------------------------------------------------------------------------------

# Habilitar caché de consultas (true, false)
QUERY_CACHE_ENABLED=true

# Tiempo de caché en segundos
QUERY_CACHE_TIME=300

# ------------------------------------------------------------------------------
# EMAIL (Opcional - para notificaciones por correo)
# ------------------------------------------------------------------------------

# Habilitar envío de emails (true, false)
EMAIL_ENABLED=false

# Servidor SMTP
SMTP_HOST=smtp.gmail.com

# Puerto SMTP
SMTP_PORT=587

# Usuario SMTP
SMTP_USER=

# Contraseña SMTP
SMTP_PASS=

# Email "From"
EMAIL_FROM=videoteca@sfxavier.edu.bo

# Nombre "From"
EMAIL_FROM_NAME=Videoteca San Francisco Xavier

# ------------------------------------------------------------------------------
# BACKUP AUTOMÁTICO (Opcional)
# ------------------------------------------------------------------------------

# Habilitar backups automáticos (true, false)
BACKUP_ENABLED=false

# Directorio de backups
BACKUP_DIR=/var/backups/videoteca

# Frecuencia de backups (diaria, semanal)
BACKUP_FREQUENCY=diaria

# Días de retención de backups
BACKUP_RETENTION_DAYS=30
